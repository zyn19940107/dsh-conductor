{
  "name": "@zyn19940107/dsh-conductor",
  "version": "2.10.1",
  "description": "DeepSeek Harness 插件：把「想→做→看→再想」的串行链换成「规划一次→并行做N件→一次性收N个结论」。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyn19940107/dsh-refine-loop.git"
  },
  "homepage": "https://github.com/zyn19940107/dsh-refine-loop#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agent-loop",
    "planning",
    "subagent",
    "parallel"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "specs": "node verify/run-specs.mjs",
    "bench": "node bench/compare.mjs 3",
    "prepare": "node build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0"
  }
}
